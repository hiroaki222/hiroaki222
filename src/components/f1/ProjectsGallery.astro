---
import type { Project } from '@/lib/profile'
import SectionHeader from '@/components/f1/SectionHeader.astro'
import ProjectCard from '@/components/f1/ProjectCard.astro'
interface Props {
  projects: Project[]
  id?: string
  // 一覧ページへの導線. トップでは件数を絞って表示するため, 全件はそちらへ逃がす.
  moreHref?: string
}
const { projects, id = 'projects', moreHref } = Astro.props
---

<section class="gallery-section" id={id}>
  <div class="gallery-inner">
    <SectionHeader title="Projects" />
    <slot name="controls" />
    <div class="articles">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
    {moreHref && (
      <a class="all" href={moreHref}>All Projects</a>
    )}
  </div>
</section>

<style>
  .gallery-section {
    background: var(--f1-dark);
    padding: 48px 48px;
  }
  @media (max-width: 720px) {
    .gallery-section { padding: 40px 8px; }
  }
  .gallery-inner { max-width: var(--container); margin: 0 auto; }
  .articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 28px;
    font-family: var(--font-display);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--f1-red);
  }
  .all::after { content: '→'; font-size: 16px; }
  .all:hover { text-decoration: none; opacity: 0.75; }
</style>
